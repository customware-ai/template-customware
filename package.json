{
  "name": "template-customware",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack Customware template with a Vite+ monorepo workspace",
  "type": "module",
  "scripts": {
    "dev": "vp run --no-cache --parallel --filter @template-customware/api --filter @template-customware/app dev",
    "build": "vp run --filter @template-customware/api build",
    "start": "node --env-file-if-exists=.env build/server/start.js",
    "start:e2e": "node tests/e2e/server-start.mjs",
    "lint": "vp run --filter @template-customware/app typegen && vp lint apps packages",
    "test": "vp test --run --config vitest.config.ts",
    "prepare:e2e": "tsx tests/e2e/prepare.ts",
    "e2e": "pnpm run build && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx apps/api/src/db/migrate.ts",
    "typecheck": "vp run --filter ./apps/app --filter ./apps/api --filter ./packages/shared type-check",
    "prepare": "vp config"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@hono/trpc-server": "0.4.2",
    "@trpc/server": "11.19.0",
    "better-result": "catalog:",
    "better-sqlite3": "13.0.3",
    "dotenv": "18.0.7",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "jsdom": "29.1.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.11.2"
}
