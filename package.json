{
  "name": "template-customware",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack Customware template with a Vite+ monorepo workspace",
  "type": "module",
  "scripts": {
    "dev": "vp run --no-cache --parallel --filter @template-customware/api --filter @template-customware/app dev",
    "build": "vp run --filter @template-customware/api build",
    "start": "node --env-file-if-exists=.env build/server/start.js",
    "start:e2e": "node tests/e2e/server-start.mjs",
    "lint": "vp run --filter @template-customware/app typegen && vp lint apps packages",
    "test": "vp test --run --config vitest.config.ts",
    "prepare:e2e": "tsx tests/e2e/prepare.ts",
    "e2e": "pnpm run build && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx apps/api/src/db/migrate.ts",
    "prepare": "vp config"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@hono/trpc-server": "0.4.2",
    "@trpc/server": "catalog:",
    "better-result": "catalog:",
    "better-sqlite3": "13.0.3",
    "dotenv": "catalog:",
    "drizzle-orm": "0.45.4",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "catalog:",
    "drizzle-kit": "0.31.11",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsrs": "catalog:",
    "tsx": "4.23.15",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.11.2"
}
