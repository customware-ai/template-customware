{
  "name": "customware",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack app template for Customware, with a Vite+ monorepo workspace",
  "type": "module",
  "scripts": {
    "dev": "vp run --parallel --filter @cw/api --filter @cw/app dev",
    "build": "vp run --filter @cw/api build",
    "start": "node --env-file=.env apps/api/dist/start.js",
    "start:e2e": "node tests/e2e/server-start.mjs",
    "lint": "vp run --filter @cw/app typegen && vp lint apps packages",
    "test": "vp test --run --config vitest.config.ts",
    "prepare:e2e": "tsx tests/e2e/prepare.ts",
    "e2e": "pnpm run build && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx apps/api/src/db/migrate.ts",
    "prepare": "vp config"
  },
  "dependencies": {
    "@cw/api": "workspace:*",
    "better-result": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "drizzle-kit": "0.31.11",
    "jsdom": "31.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsrs": "catalog:",
    "tsx": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.11.2"
}
